# Supabase: Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Только на сервере! Нужен для записи подписей с проверкой IP
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Антинакрутка
IP_HASH_SALT=замените-на-длинную-случайную-строку
# Сколько подписей под одной петицией допускается с одного IP.
# Не ставьте 1: участники одного ивента сидят в общей Wi-Fi сети.
SIGN_MAX_PER_IP=5

NEXT_PUBLIC_SITE_URL=http://localhost:3000
